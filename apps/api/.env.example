# Plus-Minus NBA Backend — Environment Variables
# Copy this file to .env and fill in your keys

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# CORS — comma-separated list of allowed frontend origins
# For local dev: http://localhost:8080,http://127.0.0.1:5500
# For production: https://your-cloudflare-pages-domain.pages.dev
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500

# Port the backend listens on (default 8000)
PORT=8000
